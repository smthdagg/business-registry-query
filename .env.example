# ============ 工商企业聚合信息查询系统 配置 ============
# 复制为 .env 后填写，.env 不要提交到代码仓库

# 访问口令（必填，建议长一点）。留空 = 不启用登录（仅限本地调试）
ADMIN_PASSWORD=change-me-to-a-long-password

# 普通会员口令（可选）：设置后登录页可选“普通会员”角色（只读查询，
# 无法访问 设置/日志）；留空则只有管理员账号
MEMBER_PASSWORD=

# Cookie 签名密钥。留空则首次启动自动生成到 data/secret.key
# SECRET_KEY=

# 默认数据源：all = 聚合查询（推荐，并行打全部源）；也可指定 tyc/aqc/rb/c88/mock
DATA_SOURCE=all

# 天眼查配置（用真实查询时必须填）
# 获取方法：浏览器登录 https://m.tianyancha.com，F12 -> Network 里
# 随便点一个请求 -> 复制 Request Headers 里的完整 Cookie 值粘贴到这里
# Cookie 含账号凭证，请勿泄露 / 提交到仓库
TYC_COOKIE=

# 爱企查（百度）：免登录配额极低，日常使用需浏览器登录 Cookie
# 获取：浏览器登录 https://aiqicha.baidu.com -> F12 -> Network -> 任一请求 -> 复制完整 Cookie
# AQC_COOKIE=
# AQC_DELAY=1.5

# 风鸟（riskbird.com）：免费注册账号，接口需登录 Cookie
# RB_COOKIE=
# RB_DELAY=1.5

# 88查（88cha.com，阿里出品）：免注册账号，但 MTOP 网关有滑块风控
# 获取：浏览器打开 https://88cha.com 随便搜一次 -> F12 复制完整 Cookie
# CHA88_COOKIE=
# CHA88_DELAY=1

# 天眼查每次请求的最小间隔（秒），调大更安全
TYC_DELAY=2

# 接口地址（默认天眼查移动站搜索接口）。接口改版/需要走代理时可填新的可用地址
# TYC_URL=https://m.tianyancha.com/proxyPeers/getCompanyPhone.json

# 单次请求超时（秒）
# REQUEST_TIMEOUT=15

# 实时源结果缓存时长（秒，默认 6 小时）
# CACHE_TTL=21600

# 历史记录保留条数
# HISTORY_MAX_ROWS=200

# 批量任务最大行数
# BATCH_MAX_LINES=500

# 关联分析预算（节点上限 / 最大深度）
# RELATION_MAX_NODES=60
# RELATION_MAX_DEPTH=3

# 端口（docker-compose 映射用，镜像内固定 8000）
# 如需改端口，同时改 docker-compose.yml 的 ports